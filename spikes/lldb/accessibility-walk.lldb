expr -l objc -- @import Foundation
expr -l objc -- @import UIKit
expr -l objc -O -- NSMutableString *out = [NSMutableString string]; NSMutableArray *stack = [NSMutableArray arrayWithObject:(NSObject *)[[UIApplication sharedApplication] keyWindow]]; int n = 0; while ([stack count] > 0 && n < 5000) { NSObject *e = (NSObject *)[stack lastObject]; [stack removeLastObject]; n++; if ([e isAccessibilityElement]) { NSString *ident = [e respondsToSelector:@selector(accessibilityIdentifier)] ? (NSString *)[(id)e accessibilityIdentifier] : nil; [out appendFormat:@"%@ | label=%@ | value=%@ | id=%@ | traits=%llu | frame=%@\n", NSStringFromClass([e class]), [e accessibilityLabel], [e accessibilityValue], ident, (unsigned long long)[e accessibilityTraits], (id)[(id)e valueForKey:@"accessibilityFrame"]]; } NSArray *kids = [e accessibilityElements]; if (kids == nil) { NSInteger c = [e accessibilityElementCount]; if (c > 0 && c < 10000) { NSMutableArray *a = [NSMutableArray array]; for (NSInteger i = 0; i < c; i++) { id k = [e accessibilityElementAtIndex:i]; if (k) [a addObject:k]; } kids = a; } } if (kids == nil && [e isKindOfClass:[UIView class]]) kids = [(UIView *)e subviews]; for (id k in [kids reverseObjectEnumerator]) [stack addObject:k]; } out
detach
